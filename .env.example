# このファイルをコピーして .env を作り、値を埋めてください（.env はコミットしないこと）
# ローカルで動かす場合は `pip install python-dotenv` の上で server.py の先頭に
# `from dotenv import load_dotenv; load_dotenv()` を追記するか、
# 各変数を環境変数として直接セットしてください。
# Renderにデプロイする場合はこれらをRenderの環境変数(Environment)に設定します。

# ログイン用の共通パスワード（3〜4台のスマホで共有する合言葉）
APP_PASSWORD=change-me

# Flaskのセッション署名用シークレット（ランダムな長い文字列にする）
# 生成例: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-too

# Cloudinaryのダッシュボード(Settings > Access Keys)にある値
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
